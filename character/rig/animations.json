          { "at": 1900, "rotation": -1.2 },
          { "at": 4200, "rotation": 0 }
        ],
        "head": [
          { "at": 0, "y": 0 },
          { "at": 2100, "y": -1.5 },
          { "at": 4200, "y": 0 }
        ]
      }
    },

    "hairIdle": {
